rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/customers/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- CUSTOMERS ---
    match /customers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      function isOrderOwner() {
        return isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      }
      
      allow read: if isOrderOwner() || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // --- COUPONS ---
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (resource.data.userId == request.auth.uid);
    }

    // --- SETTINGS ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
