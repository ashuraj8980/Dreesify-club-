rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTrustedAdmin() {
      return isSignedIn() && 
        request.auth.token.email in [
          'ashukumar8076801908@gmail.com', 
          'sanachauhan393@gmail.com',
          'dressifyindia@gmail.com',
          'kumarashu807680@gmail.com'
        ];
    }

    function isAdmin() {
      // Simplified: If the email is in the trusted list, they are an admin.
      // We remove the exists() check to prevent syncing hangs.
      return isTrustedAdmin();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidCustomer(data) {
      return data.email is string &&
             data.role in ['user', 'admin'] &&
             data.id == request.auth.uid;
    }

    function isValidProduct(data) {
      // Basic validation to allow writes from trusted admins
      return data.name is string &&
             data.price is number;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.status in ['pending', 'confirmed', 'packed', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid &&
             data.productId is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    // --- Collection Rules ---

    // Customers
    match /customers/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isValidCustomer(incoming()) || isTrustedAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update, delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    // Coupons (Admin only)
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}